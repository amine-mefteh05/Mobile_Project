<?xml version="1.0" encoding="utf-8"?>
<!--
    Home is a morning briefing, read top to bottom:
      greeting → what to do right now → the day in numbers → shortcuts → today's timeline.
    Few containers: the assistant note is set off by a green rule, metrics by hairlines.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="20dp"
        android:paddingBottom="@dimen/space_xxl">

        <!-- ===== Header ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textHomeDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.UniMate.Overline"
                tools:text="Thursday, 19 November" />

            <TextView
                android:id="@+id/textHomeAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/accent"
                android:clickable="true"
                android:contentDescription="Open profile"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.UniMate.Label"
                android:textColor="@color/on_brand"
                tools:text="AD" />
        </LinearLayout>

        <TextView
            android:id="@+id/textHomeGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="40dp"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.UniMate.Display"
            tools:text="Good evening, Alex" />

        <!-- ===== Right now (assistant) ===== -->
        <LinearLayout
            android:id="@+id/cardAssistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_accent_bar"
                android:backgroundTint="@color/brand_fill" />

            <LinearLayout
                android:id="@+id/layoutAssistantContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:animateLayoutChanges="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/brand" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Right now"
                        android:textAppearance="@style/TextAppearance.UniMate.Overline"
                        android:textColor="@color/brand" />

                    <TextView
                        android:id="@+id/textAssistantTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.UniMate.Label"
                        android:textColor="@color/text_tertiary"
                        tools:text="14:05" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textSuggestionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Looking at your day…"
                    android:textAppearance="@style/TextAppearance.UniMate.Title" />

                <TextView
                    android:id="@+id/textSuggestionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:textAppearance="@style/TextAppearance.UniMate.BodySecondary"
                    tools:text="You have a 90 minute window before your next class." />

                <LinearLayout
                    android:id="@+id/layoutSuggestionReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Why  "
                        android:textAppearance="@style/TextAppearance.UniMate.Label"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/textSuggestionReason"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="@style/TextAppearance.UniMate.Caption"
                        android:textStyle="italic"
                        tools:text="It is the most urgent pending task and fits the free slot." />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutRecommendedSpot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="36dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location"
                        app:tint="@color/brand" />

                    <TextView
                        android:id="@+id/textRecommendedSpot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="@style/TextAppearance.UniMate.Label"
                        android:textColor="@color/brand"
                        android:textSize="13sp"
                        tools:text="Best spot right now: Campus Central Library" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhatNowAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="42dp"
                    android:text="Open task"
                    android:visibility="gone"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== The day in numbers ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-14dp"
            android:baselineAligned="false"
            android:divider="@drawable/divider_hairline"
            android:dividerPadding="6dp"
            android:orientation="horizontal"
            android:paddingVertical="14dp"
            android:showDividers="middle">

            <include
                android:id="@+id/statTasks"
                layout="@layout/view_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/statEvents"
                layout="@layout/view_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/statBudget"
                layout="@layout/view_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <!-- ===== Budget alert (only when tight) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHomeBudgetBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/warning_soft"
            app:cardCornerRadius="10dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textHomeBudgetBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Budget almost spent"
                        android:textAppearance="@style/TextAppearance.UniMate.Subtitle"
                        android:textColor="@color/warning" />

                    <TextView
                        android:id="@+id/textHomeBudgetBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textAppearance="@style/TextAppearance.UniMate.Caption"
                        android:textColor="@color/text_primary"
                        tools:text="82.00 of 100.00 TND used this week" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/warning" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Shortcuts ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-8dp"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="horizontal">

            <include
                android:id="@+id/btnQuickAddTask"
                layout="@layout/view_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/btnQuickAddEvent"
                layout="@layout/view_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/btnQuickPlanWeek"
                layout="@layout/view_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/btnQuickBudget"
                layout="@layout/view_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ===== Today ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="Today"
                android:textAppearance="@style/TextAppearance.UniMate.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeePlanner"
                style="@style/Widget.UniMate.Button.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-8dp"
                android:text="Week view" />
        </LinearLayout>

        <include
            android:id="@+id/emptyAgenda"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTodayAgenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
