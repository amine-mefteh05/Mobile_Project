<?xml version="1.0" encoding="utf-8"?>
<!--
    Ranked study spot: the personal match score leads (serif numeral + hairline meter),
    then name, place and amenities as quiet inline text. Flat, divider-separated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingVertical="16dp">

    <!-- Score column -->
    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textSpotScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.UniMate.Metric"
            android:textColor="@color/brand"
            tools:text="96" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSpotScore"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            app:trackColor="@color/stroke"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="match"
            android:textAppearance="@style/TextAppearance.UniMate.Label"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textSpotName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.UniMate.Subtitle"
            android:textSize="16sp"
            tools:text="Campus Central Library" />

        <TextView
            android:id="@+id/textSpotAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.UniMate.Caption"
            tools:text="Library · Main Campus, Building A" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupSpotAmenities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="14dp"
            app:chipSpacingVertical="4dp">

            <TextView
                android:id="@+id/textSpotWifi"
                style="@style/UniMate.Amenity"
                android:text="Wi-Fi" />

            <TextView
                android:id="@+id/textSpotOutlets"
                style="@style/UniMate.Amenity"
                android:text="Outlets" />

            <TextView
                android:id="@+id/textSpotNoise"
                style="@style/UniMate.Amenity"
                tools:text="Very quiet" />

            <TextView
                android:id="@+id/textSpotPrice"
                style="@style/UniMate.Amenity"
                tools:text="Free" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Engine's raw breakdown; kept for the adapter but not shown in the list. -->
        <TextView
            android:id="@+id/textSpotBreakdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnFavSpot"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="-12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Save spot"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_star_outline"
        app:tint="@color/text_tertiary" />
</LinearLayout>
