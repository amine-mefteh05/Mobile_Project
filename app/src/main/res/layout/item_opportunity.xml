<?xml version="1.0" encoding="utf-8"?>
<!--
    Opportunity row, laid out like a notice board: the deadline is the anchor (serif date
    column on the left), then category, title and organiser. Flat, divider-separated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingVertical="16dp">

    <!-- Date column -->
    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textOppDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="lnum"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.UniMate.Metric"
            tools:text="24" />

        <TextView
            android:id="@+id/textOppMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.UniMate.Overline"
            tools:text="NOV" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textOppCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:textAppearance="@style/TextAppearance.UniMate.Label"
            android:textSize="11sp"
            tools:text="Workshop" />

        <TextView
            android:id="@+id/textOppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.UniMate.Subtitle"
            android:textSize="16sp"
            tools:text="Advanced Android Architecture Workshop" />

        <TextView
            android:id="@+id/textOppOrg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.UniMate.Caption"
            tools:text="Google Developer Student Club" />

        <TextView
            android:id="@+id/textOppDeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.UniMate.Label"
            tools:text="Closes in 5 days" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnFavOpp"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="-12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Save opportunity"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_star_outline"
        app:tint="@color/text_tertiary" />
</LinearLayout>
