<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/gutter"
            android:paddingTop="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textTasksSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.UniMate.Overline"
                        tools:text="3 pending · 1 overdue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityHeading="true"
                        android:text="Tasks"
                        android:textAppearance="@style/TextAppearance.UniMate.Display" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSortTasks"
                    style="@style/Widget.UniMate.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Sort tasks"
                    android:text="Deadline"
                    app:icon="@drawable/ic_sort"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Status segmented control -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                app:checkedButton="@id/segAll"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segAll"
                    style="@style/Widget.UniMate.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segPending"
                    style="@style/Widget.UniMate.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="To do" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segDone"
                    style="@style/Widget.UniMate.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Done" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segOverdue"
                    style="@style/Widget.UniMate.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Overdue" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Category filter -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/gutter"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:tag="ALL"
                    android:text="All categories" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatUniv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="UNIVERSITY"
                    android:text="University" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatProj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="PROJECT"
                    android:text="Project" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatExam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="EXAM"
                    android:text="Exam" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatPersonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="PERSONAL"
                    android:text="Personal" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_m"
            android:layout_weight="1">

            <include
                android:id="@+id/emptyTasks"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewTasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingBottom="@dimen/fab_clearance" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/gutter"
        android:contentDescription="Add task"
        android:text="Task"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
