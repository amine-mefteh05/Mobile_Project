<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarOppDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize">

        <ImageButton
            android:id="@+id/btnOppDetailsFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save to favorites"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_secondary" />
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/gutter"
            android:paddingTop="4dp"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/textOppDetailsCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.UniMate.Label"
                tools:text="Hackathon" />

            <TextView
                android:id="@+id/textOppDetailsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.UniMate.Display"
                android:textSize="26sp"
                tools:text="Google Developer Hackathon 2026" />

            <TextView
                android:id="@+id/textOppDetailsOrg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.UniMate.BodySecondary"
                tools:text="GDG Tunis" />

            <!-- Key facts -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_padding">

                        <ImageView
                            android:id="@+id/iconOppDeadline"
                            android:layout_width="@dimen/icon_tile"
                            android:layout_height="@dimen/icon_tile"
                            android:background="@drawable/bg_icon_tile"
                            android:importantForAccessibility="no"
                            android:padding="10dp"
                            android:src="@drawable/ic_flag"
                            app:tint="@color/brand" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Deadline"
                                android:textAppearance="@style/TextAppearance.UniMate.Caption" />

                            <TextView
                                android:id="@+id/textOppDetailsDeadline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.UniMate.Subtitle"
                                tools:text="Fri, 5 Dec 2026" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textOppDetailsClosing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:background="@drawable/bg_tag"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textAppearance="@style/TextAppearance.UniMate.Label"
                            android:textSize="11sp"
                            tools:text="Closes in 16 days" />
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerOppLink"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="68dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        android:id="@+id/rowOppLink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_padding">

                        <ImageView
                            android:layout_width="@dimen/icon_tile"
                            android:layout_height="@dimen/icon_tile"
                            android:background="@drawable/bg_icon_tile"
                            android:importantForAccessibility="no"
                            android:padding="10dp"
                            android:src="@drawable/ic_open_in_new"
                            app:tint="@color/brand" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Website"
                                android:textAppearance="@style/TextAppearance.UniMate.Caption" />

                            <TextView
                                android:id="@+id/textOppDetailsLink"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.UniMate.Subtitle"
                                tools:text="gdg.community.dev" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_m"
                            android:layout_height="@dimen/icon_m"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:accessibilityHeading="true"
                android:text="About"
                android:textAppearance="@style/TextAppearance.UniMate.Overline" />

            <TextView
                android:id="@+id/textOppDetailsDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:lineSpacingMultiplier="1.25"
                android:textAppearance="@style/TextAppearance.UniMate.Body"
                android:textIsSelectable="true"
                tools:text="A 48-hour hackathon for students building with Google technologies." />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomBarOppDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/gutter"
            android:paddingVertical="@dimen/space_m">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddDeadlineAsTask"
                style="@style/Widget.UniMate.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add to tasks"
                app:icon="@drawable/ic_tasks" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenOppLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:text="Apply"
                app:icon="@drawable/ic_open_in_new"
                app:iconGravity="textEnd" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
